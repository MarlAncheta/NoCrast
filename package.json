{
  "name": "nocrast",
  "private": true,
  "version": "0.2.0",
  "description": "A local-first productivity tracker: task timers that start when you create a task, staged deadline warnings as desktop notifications, manual breaks, and procrastination analytics.",
  "keywords": [
    "productivity",
    "procrastination",
    "task-manager",
    "time-tracker",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "indexeddb",
    "dexie",
    "notifications"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
